{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "C/C++: gcc build and debug",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/video_player.exe",
        "args": [],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "externalConsole": true,
        "MIMode": "gdb",
        "miDebuggerPath": "gdb",
        "setupCommands": [
          {
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ],
        "preLaunchTask": "",
        "internalConsoleOptions": "neverOpen"
      }
    ]
  }
  